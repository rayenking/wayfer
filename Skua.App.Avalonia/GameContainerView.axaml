<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:web="using:Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignHeight="550" d:DesignWidth="958"
    x:Class="Skua.App.Avalonia.GameContainerView">
    <Grid>
        <web:NativeWebView x:Name="GameWebView" />
        <Border x:Name="LoadingOverlay" Background="#CC000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressBar Width="180" Height="18" IsIndeterminate="True" />
                <TextBlock x:Name="StatusText" Text="Starting local game server..." Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
