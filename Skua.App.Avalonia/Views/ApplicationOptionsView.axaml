<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
    xmlns:views="clr-namespace:Skua.App.Avalonia.Views" x:Class="Skua.App.Avalonia.Views.ApplicationOptionsView" x:DataType="vm:ApplicationOptionsViewModel">
    <Grid RowDefinitions="Auto,*" Margin="8">
        <TextBlock Grid.Row="0" Text="Options with * require an application restart." FontStyle="Italic" Foreground="Gray" Margin="0,0,0,8" />
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ApplicationOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DisplayOptionItemViewModelBase">
                        <views:OptionItemView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
