<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Skua.Core.ViewModels;assembly=Skua.Core"
    x:Class="Skua.App.Avalonia.Views.OptionItemView"
    x:DataType="vm:DisplayOptionItemViewModelBase">
    <Border Margin="0,2" Padding="6,4" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Content}" />
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray"
                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <ContentControl x:Name="ControlHost" Grid.Column="1" Margin="8,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
