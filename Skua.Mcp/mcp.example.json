{
  "mcpServers": {
    "wayfer": {
      "command": "dotnet",
      "args": [
        "/absolute/path/to/Skua.Mcp/bin/Debug/net10.0/Skua.Mcp.dll"
      ],
      "env": {
        "WAYFER_CONTROL_URL": "http://127.0.0.1:8766",
        "WAYFER_CONTROL_TOKEN": "replace-with-your-control-token"
      }
    }
  }
}
